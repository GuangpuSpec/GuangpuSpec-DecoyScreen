    },
    "The outer screen faces the people across from you. It shows your decoy while you watch.": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外屏朝向你对面的人。你看视频时，外屏显示伪装。"
